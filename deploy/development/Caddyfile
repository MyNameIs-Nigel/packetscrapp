# Local origin behind Cloudflare Tunnel. Never bind this plaintext listener publicly.
http://127.0.0.1:8080 {
    bind 127.0.0.1
    root * /opt/packetscrapp/development/current/client
    @room path /r/*
    rewrite @room /index.html
    @entry path / /index.html /r/*
    header @entry Cache-Control "no-store"
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header X-Content-Type-Options "nosniff"
    file_server
}
