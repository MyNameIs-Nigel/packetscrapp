PACKET_ENV=local
PACKET_REGION=local
PACKET_HOST=127.0.0.1
PACKET_PORT=2567
# Exact browser origin admitted for HTTP and WebSocket requests.
# Local mode fixes http://127.0.0.1:5173; development requires https://dev.packetscr.app;
# production requires its own https origin. Required outside local mode.
# PACKET_CLIENT_ORIGIN=https://dev.packetscr.app
# Rooms this process holds before /health reports accepting:false (default 20).
# PACKET_MAX_ROOMS=20
